# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL Database ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksense_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ─── JWT Auth ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
