# ==============================================================================
# StockSense Backend Environment Configuration Blueprint
# ==============================================================================
# Hey team! Copy this file to `.env` in the backend root directory before running.
# Never commit your actual `.env` file with secret database passwords to Git!
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksense_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Secret for Session Authentication
JWT_SECRET=stocksense_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
